# Copy to .env for local testing only. NEVER commit a real .env here.
# NEVER reference these in any client/Vite (`VITE_*`) env var or bundle.

# Privileged/server-side Postgres connection string for the Neon branch.
# Must be a real service-level Postgres role that bypasses RLS by design
# (analogous to Supabase's old service_role) -- NOT the Data API
# "authenticated" role used by the browser client.
DATABASE_URL=postgres://<privileged_role>:<password>@<host>/<db>?sslmode=require

# Full Firebase service account JSON contents (single line), from
# Firebase Console > Project Settings > Service Accounts > Generate New
# Private Key. Same credential class the old Supabase Edge Function used.
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Optional overrides (defaults shown):
# REMINDER_WINDOW_SECONDS=60
# REMINDER_LOOKAHEAD_HOURS=24
